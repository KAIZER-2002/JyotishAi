# ---------------------------------------------------------------------------
# JyotishAI - Environment Configuration Template
# ---------------------------------------------------------------------------

# General Application Settings
APP_NAME=JyotishAI API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Security Settings
# Generate a 32-byte hex key (e.g. openssl rand -hex 32)
SECRET_KEY=replace_with_a_secure_32_byte_hex_key

# PostgreSQL Database Configuration
POSTGRES_USER=jyotish_prod_user
POSTGRES_PASSWORD=replace_with_secure_postgres_password
POSTGRES_DB=jyotishai_production

# Alembic & Database Connection URL
# Use 'postgres' hostname when running inside Docker Compose
DATABASE_URL=postgresql+asyncpg://jyotish_prod_user:replace_with_secure_postgres_password@postgres:5432/jyotishai_production

# ChromaDB Vector Database Configuration
CHROMA_PERSIST_DIR=chroma_db
CHROMA_HOST=chroma
CHROMA_PORT=8000

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=30

OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ASTROLOGY_API_KEY=your_astrology_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost/api/v1
