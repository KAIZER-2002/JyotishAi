# ---------------------------------------------------------------------------
# JyotishAI - Production Environment Configuration Template
# Rename this file to '.env' in your production environment and populate variables.
# ---------------------------------------------------------------------------

# General FastAPI Configuration
APP_NAME=JyotishAI API
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Security Settings (CRITICAL: Change these to highly secure values in production)
# Secret key should be a 32-byte hex string (e.g. generated via 'openssl rand -hex 32')
SECRET_KEY=generate-a-secure-32-byte-hex-key-here

# PostgreSQL Database Settings
POSTGRES_USER=jyotish_prod_user
POSTGRES_PASSWORD=replace-with-a-very-secure-password
POSTGRES_DB=jyotishai_production

# Alembic Database Migration Connection URL
# Replace database credentials and hostname (use 'postgres' if running in Docker Compose)
DATABASE_URL=postgresql+asyncpg://jyotish_prod_user:replace-with-a-very-secure-password@postgres:5432/jyotishai_production

# ChromaDB Configuration
# Set CHROMA_HOST to 'chroma' for docker-compose standalone service, or leave blank to fallback to local files
CHROMA_PERSIST_DIR=chroma_db
CHROMA_HOST=chroma
CHROMA_PORT=8000

# LLM Provider API Keys (Populate keys to enable astrological readings)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
ASTROLOGY_API_KEY=your_astrology_api_key_here

# Local LLM Fallback Options (Optional)
LOCAL_LLM_URL=http://localhost:11434
LOCAL_LLM_TIMEOUT=60

# Frontend Next.js Settings (Reachable address of reverse proxy port 80 / SSL 443)
NEXT_PUBLIC_API_URL=http://localhost/api/v1
